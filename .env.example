# KyndForm Monorepo Local Environment Variables Overview
# For package-specific configuration, see:
# - packages/server/.env.example
# - packages/webapp/.env.example

# Webapp (Vite)
PORT=3000
VITE_HOMEPAGE_URL=http://127.0.0.1:3000
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Backend Server (NestJS)
APP_LISTEN_PORT=8000
APP_HOMEPAGE_URL=http://localhost:8000
MONGO_URI=mongodb://localhost:27017/kyndform
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
