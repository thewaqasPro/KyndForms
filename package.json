{
  "name": "kyndform",
  "homepage": "https://kyndform.com",
  "author": "KyndForm, Inc.",
  "license": "AGPL-3.0",
  "private": true,
  "engines": {
    "pnpm": ">=8",
    "node": ">=20"
  },
  "scripts": {
    "dev": "run-p dev:webapp dev:server",
    "dev:webapp": "pnpm --filter ./packages/webapp dev",
    "dev:server": "pnpm --filter ./packages/server dev",
    "build:packages": "pnpm -r --filter \"@kyndform/*\" build",
    "build:server": "pnpm build:packages && pnpm --filter ./packages/server build",
    "build:webapp": "pnpm build:packages && pnpm --filter ./packages/webapp build",
    "build": "pnpm build:packages && pnpm build:server && pnpm build:webapp",
    "format": "prettier --write \"packages/**/*.{js,ts,tsx,css}\"",
    "lint": "node scripts/run-oxlint.js packages",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm --filter ./packages/utils test && pnpm --filter ./packages/answer-utils test",
    "verify:integrity": "node scripts/verify-integrity.js",
    "make-admin": "node scripts/make-admin.js",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "if ! command -v node >/dev/null 2>&1; then for d in \"$HOME\"/.nvm/versions/node/*/bin; do [ -d \"$d\" ] && PATH=\"$d:$PATH\"; done; export PATH; fi; ./node_modules/.bin/lint-staged --concurrent false"
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --parser=typescript --write",
      "node scripts/run-oxlint.js packages --fix --ignore-pattern '*.d.ts'"
    ]
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "lint-staged": "^15.5.1",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.13.0"
  }
}
